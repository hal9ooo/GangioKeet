.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
.superpowers/

# STT evaluation: local corpus/audio, raw reports, experimental eval venvs
tests/fixtures/stt_eval/audio/
tests/fixtures/stt_eval/public/*/audio/
tests/fixtures/stt_eval/*.wav
tests/fixtures/stt_eval/*.pcm
tests/fixtures/stt_eval/manifest.jsonl
tests/fixtures/stt_eval/manifest.local.jsonl
reports/stt_eval/
.stt-eval-venv/
.venv-stt-eval/

# Local secrets and private overrides
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
client_config.yaml
*.log

# Local opt-in dictation recordings: audio and transcripts never get committed
recordings/

# Windows ONNX STT model (downloaded by scripts/fetch_stt_model.py)
models/*
# Model license texts under the installer are small and must be tracked
!client-windows/installer/licenses/models/
!client-windows/installer/licenses/models/**
*.tar.bz2

# Native builds and local monolith evaluation artefacts
client-windows/**/bin/
client-windows/**/obj/
client-windows/native/build/
client-windows/native/vendor/
tests/fixtures/stt_eval/public/*/manifest.jsonl
reports/local-monolith/
artifacts/

# Public model identities are source; downloaded model bytes remain ignored.
!client-windows/models/
client-windows/models/*
!client-windows/models/*.json
.commandcode/taste/coding-style/taste.md
.commandcode/taste/workflow/taste.md
