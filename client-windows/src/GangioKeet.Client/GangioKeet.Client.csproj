<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GangioKeet.Client</RootNamespace>
    <AssemblyName>GangioKeet.Client</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gangio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GangioKeet.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gangio.ico" />
    <Resource Include="Assets\gangio-cover.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GangioKeet.Inference\GangioKeet.Inference.csproj" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="YamlDotNet" Version="17.0.0" />
  </ItemGroup>

</Project>
