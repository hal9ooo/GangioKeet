<Window x:Class="GangioKeet.Client.Ui.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640"
        Height="344"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!-- WPF rifiuta un RenderTransform su Window (CoerceRenderTransform).
         La scala d'ingresso vive sulla radice, che è l'elemento disegnato. -->
    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="SplashScale" ScaleX="0.98" ScaleY="0.98" />
        </Grid.RenderTransform>
        <Border CornerRadius="10">
            <Border.Background>
                <ImageBrush ImageSource="../Assets/chattyneko-cover.png" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <!-- Il coro di gatti occupa il centro: il titolo sta in alto a sinistra,
             dove l'immagine è vuota, con una sfumatura che lo tiene leggibile. -->
        <Border VerticalAlignment="Top" Height="118" HorizontalAlignment="Left" Width="620">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000814" Offset="0" />
                    <GradientStop Color="#40000814" Offset="0.55" />
                    <GradientStop Color="#00000814" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="40,26,0,0">
            <TextBlock Text="ChattyNeko" FontSize="34" FontWeight="SemiBold" Foreground="#F5F1E6" />
            <TextBlock Text="Dettatura locale. Nessun cloud." FontSize="13" Foreground="#C9C4B6" Margin="2,6,0,0" />
        </StackPanel>

        <Border VerticalAlignment="Bottom"
                Height="3"
                Background="#33F5F1E6"
                CornerRadius="0,0,10,10" />

        <Canvas VerticalAlignment="Bottom" Height="3" ClipToBounds="True">
            <Rectangle Height="3"
                       Width="140"
                       Fill="#22D3EE">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="BarShift" X="-140" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
    </Grid>
</Window>
