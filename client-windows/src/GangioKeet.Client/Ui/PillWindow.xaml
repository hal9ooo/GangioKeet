<Window x:Class="GangioKeet.Client.Ui.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GangioKeet"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Width="136"
        Height="28"
        WindowStartupLocation="Manual">
    <Border CornerRadius="14"
            Background="#2D2D2D"
            BorderBrush="#555555"
            BorderThickness="1"
            Padding="8,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     x:Name="StatusDot"
                     Width="8"
                     Height="8"
                     Fill="#4CAF50"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       x:Name="StatusText"
                       Text="Pronto"
                       Foreground="White"
                       FontSize="11"
                       FontFamily="Segoe UI"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
