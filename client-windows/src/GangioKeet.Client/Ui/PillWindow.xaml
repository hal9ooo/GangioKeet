<Window x:Class="GangioKeet.Client.Ui.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GangioKeet.Client.Ui"
        Title="GangioKeet"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#2D2D2D"
        AllowsTransparency="False"
        Width="220"
        Height="40"
        WindowStartupLocation="Manual">
    <Border CornerRadius="20"
            Background="#2D2D2D"
            BorderBrush="#555555"
            BorderThickness="1"
            Padding="12,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     x:Name="StatusDot"
                     Width="18"
                     Height="18"
                     Fill="#4CAF50"
                     Margin="0,0,10,0"
                     RenderTransformOrigin="0.5,0.5"
                     VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="StatusDotScale" ScaleX="0.5" ScaleY="0.5" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Grid Grid.Column="1">
                <TextBlock x:Name="StatusText"
                           Text="Pronto"
                           Foreground="White"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <local:WaveformView x:Name="WaveformPanel"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
