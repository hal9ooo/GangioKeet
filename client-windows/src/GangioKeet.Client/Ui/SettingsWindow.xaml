<Window x:Class="GangioKeet.Client.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GangioKeet — Impostazioni"
        Width="860"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        Background="#161616"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#1F1F1F" />
        <SolidColorBrush x:Key="CardBorder" Color="#2E2E2E" />
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Accent" Color="#FFD60A" />
        <SolidColorBrush x:Key="Danger" Color="#FF8A65" />
        <SolidColorBrush x:Key="Ok" Color="#2EC4B6" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#343434" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" />
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#B0B0B0"
                                          StrokeThickness="1.4"
                                          Margin="0,0,11,0"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#242424"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
 <Setter Property="Cursor" Value="Hand" />
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="CheckBox">
 <StackPanel Orientation="Horizontal">
 <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
 Background="#2A2A2A" BorderBrush="#4A4A4A" BorderThickness="1"
 VerticalAlignment="Center">
 <Path x:Name="Tick" Data="M 2 6 L 5 9 L 11 3" Stroke="#1A1A1A"
 StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
 Visibility="Collapsed" />
 </Border>
 <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
 </StackPanel>
 <ControlTemplate.Triggers>
 <Trigger Property="IsChecked" Value="True">
 <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
 <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
 <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
 </Trigger>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter TargetName="Box" Property="BorderBrush" Value="#7A7A7A" />
 </Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbChrome"
                  Background="#4A4A4A"
                  CornerRadius="4"
                  Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="#6A6A6A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBarThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <StackPanel Grid.Row="0" Margin="24,22,24,10">
            <TextBlock Text="Impostazioni" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Tutto gira su questo PC: nessun server, nessuna rete."
                       Style="{StaticResource SectionHint}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,0">
            <StackPanel>

                <!-- Motore locale -->
                <Border x:Name="LocalPanel" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Motore locale" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Lo stato del riconoscimento vocale in esecuzione su questa macchina."
                                   Style="{StaticResource SectionHint}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Stato" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StateDot" Width="8" Height="8"
                                             Fill="{StaticResource Muted}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="LocalStateText" Text="—" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Accelerazione" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="LocalBackendText" Text="—" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Combinazione attiva" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBlock x:Name="LocalPairText" Text="—" TextWrapping="Wrap" Foreground="#E8E8E8" />
                    </StackPanel>
                </Border>

                <!-- Modelli -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Modelli" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Scegli il motore vocale e, se vuoi, la rifinitura del testo."
                                   Style="{StaticResource SectionHint}" />

                        <StackPanel x:Name="ModelSelectionPanel" Margin="0,16,0,0">
                            <TextBlock Text="Motore vocale (ASR)" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AsrCombo" SelectionChanged="AsrCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding AvailabilityText}"
                                                       Foreground="{StaticResource Muted}"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox x:Name="RefinementCheck"
                                      Content="Rifinisci il testo dettato"
                                      Margin="0,16,0,0"
                                      Click="RefinementCheck_Click" />
                            <TextBlock Text="Corregge punteggiatura, maiuscole e parole storte prima di incollare."
                                       Style="{StaticResource Hint}" />

                            <TextBlock Text="Modello di rifinitura" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ComboBox x:Name="CleanerCombo" SelectionChanged="CleanerCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding AvailabilityText}"
                                                       Foreground="{StaticResource Muted}"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Senza modello: solo regole, nessun download. Con un modello: più naturale, richiede il download."
                                       Style="{StaticResource Hint}" />

                            <ProgressBar x:Name="ModelProgress"
                                         Height="4"
                                         Margin="0,14,0,0"
                                         Minimum="0"
                                         Maximum="1"
                                         Visibility="Collapsed"
                                         IsIndeterminate="False"
                                         Foreground="{StaticResource Accent}"
                                         Background="#2A2A2A"
                                         BorderThickness="0" />

                            <Button x:Name="RetryModelsButton"
                                    Content="Riprova download"
                                    HorizontalAlignment="Left"
                                    Margin="0,14,0,0"
                                    Click="RetryModelsButton_Click" />
                        </StackPanel>

                        <Separator Margin="0,18,0,16" Background="#2E2E2E" />

                        <TextBlock Text="Cartella dei modelli" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelsRootBox" Grid.Column="0" />
                            <Button x:Name="BrowseModelsRootButton" Grid.Column="1" Content="Sfoglia…"
                                    Margin="8,0,0,0" Click="BrowseModelsRootButton_Click" />
                            <Button x:Name="ApplyModelsRootButton" Grid.Column="2" Content="Applica"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Click="ApplyModelsRootButton_Click" />
                        </Grid>
                        <TextBlock x:Name="ModelsRootHint"
                                   Text="Dove stanno i pesi. Può stare su un altro disco: così non serve nessun collegamento dentro la cartella del programma."
                                   Style="{StaticResource Hint}" />
                        <Button x:Name="RestartButton"
                                Content="Riavvia GangioKeet per applicare"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Visibility="Collapsed"
                                Click="RestartButton_Click" />

                        <TextBlock x:Name="LocalErrorText"
                                   Foreground="{StaticResource Danger}"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Dettatura -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dettatura" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="I campioni restano su questo PC e servono solo a te."
                                   Style="{StaticResource SectionHint}" />

                        <CheckBox x:Name="RecordingCheck"
                                  Content="Salva le dettature completate (audio e testo)"
                                  Margin="0,16,0,0"
                                  Click="RecordingCheck_Click" />
                        <TextBlock x:Name="RecordingSummaryText"
                                   Style="{StaticResource Hint}"
                                   Margin="0,8,0,8" />
                        <Grid>
          <ListBox x:Name="RecordingList" Height="110" SelectionMode="Extended" />
          <TextBlock x:Name="RecordingEmptyText"
                     Text="Nessuna dettatura salvata finora."
                     Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>
                        <Button Content="Elimina i campioni selezionati"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Click="DeleteRecordings_Click" />
                    </StackPanel>
                </Border>

                <!-- Diagnostica -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Diagnostica" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Sola lettura: tempi e contatori dell'ultima sessione."
                                   Style="{StaticResource SectionHint}" />
                        <TextBlock x:Name="TelemetryText"
                                   Text="—"
                                   TextWrapping="Wrap"
                                   Foreground="#D8D8D8"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra di stato -->
        <Border Grid.Row="2" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
                Padding="24,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Ok}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="Pronto." Foreground="#C8C8C8" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
