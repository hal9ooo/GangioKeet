<Window x:Class="GangioKeet.Client.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GangioKeet — Impostazioni"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="520"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Text=""
                   Foreground="#FFB74D"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="LocalPanel"
                    Background="#252525"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Motore locale"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tutto resta sul PC: nessun server, nessuna rete."
                               Foreground="#9E9E9E"
                               Margin="0,2,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="backend" Style="{StaticResource Label}" />
                            <TextBlock x:Name="LocalBackendText" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="stato" Style="{StaticResource Label}" />
                            <TextBlock x:Name="LocalStateText" Text="—" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LocalPairText"
                               Text="—"
                               Foreground="#E0E0E0"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="stack modelli locale" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="StackDefaultBtn"
                                    Content="Qwen3-ASR + Gemma 4"
                                    Padding="10,5"
                                    Margin="0,0,8,6"
                                    Click="StackDefaultBtn_Click" />
                            <Button x:Name="StackParakeetBtn"
                                    Content="Parakeet + Qwen3"
                                    Padding="10,5"
                                    Margin="0,0,8,6"
                                    Click="StackParakeetBtn_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock x:Name="LocalErrorText"
                               Foreground="#FF8A65"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,10,0,8" Background="#3A3A3A" />

                    <CheckBox x:Name="RecordingCheck"
                              Content="Salva le dettature completate (audio e testo restano locali)"
                              Foreground="#E0E0E0"
                              Click="RecordingCheck_Click" />
                    <TextBlock x:Name="RecordingSummaryText"
                               Foreground="#9E9E9E"
                               Margin="0,4,0,4" />
                    <ListBox x:Name="RecordingList"
                             Height="96"
                             Background="#1E1E1E"
                             Foreground="#E0E0E0"
                             SelectionMode="Extended" />
                    <Button Content="Elimina campioni selezionati"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Click="DeleteRecordings_Click" />

                    <Separator Margin="0,10,0,8" Background="#3A3A3A" />

                    <TextBlock Text="Telemetria (sola lettura)"
                               Foreground="#B0B0B0"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="TelemetryText"
                               Text="—"
                               TextWrapping="Wrap"
                               Foreground="#E0E0E0" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
