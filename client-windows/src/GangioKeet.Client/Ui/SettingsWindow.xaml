<Window x:Class="GangioKeet.Client.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GangioKeet — Impostazioni"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="520"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Text=""
                   Foreground="#FFB74D"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="LocalPanel"
                    Background="#252525"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Motore locale"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tutto resta sul PC: nessun server, nessuna rete."
                               Foreground="#9E9E9E"
                               Margin="0,2,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="backend" Style="{StaticResource Label}" />
                            <TextBlock x:Name="LocalBackendText" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="stato" Style="{StaticResource Label}" />
                            <TextBlock x:Name="LocalStateText" Text="—" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LocalPairText"
                               Text="—"
                               Foreground="#E0E0E0"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="ModelSelectionPanel" Margin="0,10,0,0">
                        <TextBlock Text="combinazione modelli" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ASR" VerticalAlignment="Center" Foreground="#B0B0B0" />
                            <ComboBox x:Name="AsrCombo"
                                      Grid.Column="1"
                                      SelectionChanged="AsrCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding AvailabilityText}"
                                                       Foreground="#9E9E9E"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="RefinementCheck"
                                  Content="Refinement attivo"
                                  Foreground="#E0E0E0"
                                  Margin="0,6,0,4"
                                  Click="RefinementCheck_Click" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Refinement" VerticalAlignment="Center" Foreground="#B0B0B0" />
                            <ComboBox x:Name="CleanerCombo"
                                      Grid.Column="1"
                                      SelectionChanged="CleanerCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding AvailabilityText}"
                                                       Foreground="#9E9E9E"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <ProgressBar x:Name="ModelProgress"
                                     Height="4"
                                     Margin="0,6,0,0"
                                     Visibility="Collapsed"
                                     IsIndeterminate="True" />
                        <TextBlock Text="Consigliato: Parakeet + Nessuno per fedeltà e latenza; Parakeet + Gemma per domande e termini."
                                   Foreground="#9E9E9E"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="LocalErrorText"
                               Foreground="#FF8A65"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,10,0,8" Background="#3A3A3A" />

                    <CheckBox x:Name="RecordingCheck"
                              Content="Salva le dettature completate (audio e testo restano locali)"
                              Foreground="#E0E0E0"
                              Click="RecordingCheck_Click" />
                    <TextBlock x:Name="RecordingSummaryText"
                               Foreground="#9E9E9E"
                               Margin="0,4,0,4" />
                    <ListBox x:Name="RecordingList"
                             Height="96"
                             Background="#1E1E1E"
                             Foreground="#E0E0E0"
                             SelectionMode="Extended" />
                    <Button Content="Elimina campioni selezionati"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Click="DeleteRecordings_Click" />

                    <Separator Margin="0,10,0,8" Background="#3A3A3A" />

                    <TextBlock Text="Telemetria (sola lettura)"
                               Foreground="#B0B0B0"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="TelemetryText"
                               Text="—"
                               TextWrapping="Wrap"
                               Foreground="#E0E0E0" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
