<Window x:Class="GangioKeet.Client.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GangioKeet — Impostazioni"
        Width="760"
        Height="680"
        MinWidth="640"
        MinHeight="560"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="16,16,16,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="modalità"
                           Style="{StaticResource Label}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="ModeCombo"
                          Width="160"
                          SelectionChanged="ModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Locale" Tag="local" />
                    <ComboBoxItem Content="Remoto" Tag="remote" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="LocalPanel"
                Grid.Row="0"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Motore locale"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Nessun server o probe di rete in questa modalità."
                           Foreground="#9E9E9E"
                           Margin="0,2,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="backend" Style="{StaticResource Label}" />
                        <TextBlock x:Name="LocalBackendText" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="stato" Style="{StaticResource Label}" />
                        <TextBlock x:Name="LocalStateText" Text="—" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="LocalPairText"
                           Text="—"
                           Foreground="#E0E0E0"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="LocalErrorText"
                           Foreground="#FF8A65"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <Separator Margin="0,10,0,8" Background="#3A3A3A" />
                <CheckBox x:Name="RecordingCheck"
                          Content="Salva le dettature completate (audio e testo restano locali)"
                          Foreground="#E0E0E0"
                          Click="RecordingCheck_Click" />
                <TextBlock x:Name="RecordingSummaryText"
                           Foreground="#9E9E9E"
                           Margin="0,4,0,4" />
                <ListBox x:Name="RecordingList"
                         Height="96"
                         Background="#1E1E1E"
                         Foreground="#E0E0E0"
                         SelectionMode="Extended" />
                <Button Content="Elimina campioni selezionati"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Click="DeleteRecordings_Click" />
            </StackPanel>
        </Border>

        <Grid x:Name="RemoteHeader" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Endpoint STT"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Vince l'endpoint con la latenza mediana più bassa; il cambio vale dalla dettatura successiva."
                           Foreground="#9E9E9E"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#2D2D2D"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,5"
                    VerticalAlignment="Top">
                <TextBlock x:Name="SummaryText"
                           Text="Auto"
                           Foreground="#4CAF50"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ScrollViewer x:Name="RemoteList"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D2D"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#9E9E9E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="online">
                                                    <Setter Property="Fill" Value="#4CAF50" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="offline">
                                                    <Setter Property="Fill" Value="#F44336" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="nome" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="attivo"
                                               Foreground="#4CAF50"
                                               FontSize="10"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="ruolo" Style="{StaticResource Label}" />
                                    <ComboBox SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              Width="104">
                                        <ComboBoxItem Content="primario" Tag="primary" />
                                        <ComboBoxItem Content="secondario" Tag="secondary" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="host" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                    <TextBlock Text="porta" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                    <TextBlock Text="schema" Style="{StaticResource Label}" />
                                    <ComboBox SelectedValue="{Binding Scheme, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              Width="78">
                                        <ComboBoxItem Content="http" Tag="http" />
                                        <ComboBoxItem Content="https" Tag="https" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding LatencyText}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReadyText}"
                                               Foreground="#9E9E9E"
                                               FontSize="10" />
                                    <TextBlock Text="{Binding ErrorText}"
                                               Foreground="#FF8A65"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProbeText}"
                                               Foreground="#4CAF50"
                                               FontSize="10" />
                                </StackPanel>

                                <Button Grid.Column="7"
                                        Content="✕"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        ToolTip="Rimuovi endpoint"
                                        Tag="{Binding}"
                                        Click="Remove_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="RemoteTelemetry"
                Grid.Row="2"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,4,0,10">
            <StackPanel>
                <TextBlock Text="Telemetria (sola lettura)"
                           Foreground="#B0B0B0"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="TelemetryText"
                           Text="—"
                           TextWrapping="Wrap"
                           Foreground="#E0E0E0" />
            </StackPanel>
        </Border>

        <Grid x:Name="RemoteButtons" Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Aggiungi endpoint"
                    Click="Add_Click" />
            <Button Grid.Column="2"
                    Content="Verifica adesso"
                    Click="VerifyNow_Click"
                    Margin="0,0,8,0" />
            <Button x:Name="SaveButton"
                    Grid.Column="3"
                    Content="Salva"
                    Style="{StaticResource AccentButton}"
                    Click="Save_Click" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Text=""
                   Foreground="#FFB74D"
                   TextWrapping="Wrap" />
    </Grid>
    </DockPanel>
</Window>
